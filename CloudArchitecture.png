  <rect x="40" y="97.80000000000001" width="191.63199999999995" height="53.800000000000004" rx="0" ry="0" fill="var(--_node-fill)" stroke="var(--_node-stroke)" stroke-width="0.75" />
  <text x="135.81599999999997" y="124.70000000000002" text-anchor="middle" font-size="13" font-weight="500" fill="var(--_text)"><tspan x="135.81599999999997" dy="-3.9000000000000012">Azure Container Registry</tspan><tspan x="135.81599999999997" dy="16.900000000000002">(Docker images)</tspan></text>
