Azure Container Apps
(Nginx)" data-shape="rectangle">
  <rect x="353.91399999999993" y="52.175" width="172.36599999999999" height="70.7" rx="0" ry="0" fill="var(--_node-fill)" stroke="var(--_node-stroke)" stroke-width="0.75" />
  <text x="440.0969999999999" y="87.525" text-anchor="middle" font-size="13" font-weight="500" fill="var(--_text)"><tspan x="440.0969999999999" dy="-12.350000000000001">React Frontend</tspan><tspan x="440.0969999999999" dy="16.900000000000002">Azure Container Apps</tspan><tspan x="440.0969999999999" dy="16.900000000000002">(Nginx)</tspan></text>
