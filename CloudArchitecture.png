  <rect x="1071.5259999999998" y="138.7" width="148.654" height="70.7" rx="0" ry="0" fill="var(--_node-fill)" stroke="var(--_node-stroke)" stroke-width="0.75" />
  <text x="1145.8529999999998" y="174.04999999999998" text-anchor="middle" font-size="13" font-weight="500" fill="var(--_text)"><tspan x="1145.8529999999998" dy="-12.350000000000001">MongoDB</tspan><tspan x="1145.8529999999998" dy="16.900000000000002">Azure Cosmos DB</tspan><tspan x="1145.8529999999998" dy="16.900000000000002">(MongoDB API)</tspan></text>
